# WebMind Configuration
# ==============================================================================
# The ONLY secret required to run WebMind
LLM_API_KEY=

# LLM Provider: gemini | openai | anthropic (routed via LiteLLM)
LLM_PROVIDER=gemini

# Model Selection Defaults (LiteLLM format)
# ------------------------------------------------------------------------------
# Gemini:
#   FAST_MODEL=gemini/gemini-2.5-flash
#   GENERAL_MODEL=gemini/gemini-2.5-flash
#   REASONING_MODEL=gemini/gemini-2.5-pro
#   VLM_MODEL=gemini/gemini-2.5-flash
#
# OpenAI:
#   FAST_MODEL=gpt-4o-mini
#   GENERAL_MODEL=gpt-4o
#   REASONING_MODEL=o3-mini
#   VLM_MODEL=gpt-4o
#
# Anthropic:
#   FAST_MODEL=claude-3-5-haiku-20241022
#   GENERAL_MODEL=claude-3-5-sonnet-20241022
#   REASONING_MODEL=claude-3-7-sonnet-20250219
#   VLM_MODEL=claude-3-5-sonnet-20241022

FAST_MODEL=gemini/gemini-3.8-flash
GENERAL_MODEL=gemini/gemini-3.8-flash
REASONING_MODEL=gemini/gemini-3.8-flash
VLM_MODEL=gemini/gemini-3.8-flash

# Database Configuration (PostgreSQL with pgvector for Docker, or sqlite+aiosqlite for local dev)
DATABASE_URL=postgresql+asyncpg://webmind:webmind@db:5432/webmind

# Execution Settings
MAX_STEPS_PER_RUN=40
MAX_RETRIES_PER_STEP=2
HEADLESS=true
PORT=8000
HOST=0.0.0.0

# ChromaDB vector index; Docker Compose connects to its Chroma service instead
CHROMA_PERSIST_DIRECTORY=./chroma_data
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_CANDIDATE_LIMIT=500
MEMORY_SIMILARITY_THRESHOLD=0.22
MEMORY_USE_THRESHOLD=0.68
MEMORY_CAUTION_THRESHOLD=0.42
MEMORY_MIN_RELIABILITY=0.35
MEMORY_BETA_ALPHA=2.0
MEMORY_BETA_BETA=2.0
MEMORY_EMBEDDING_TIMEOUT_SECONDS=8.0
MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
